{
  "name": "housekit-frontend",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "gen:api": "openapi-typescript packages/api-client/openapi.json -o packages/api-client/src/schema.d.ts",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "openapi-typescript": "7.4.1",
    "turbo": "2.2.3",
    "typescript": "5.6.3"
  }
}
