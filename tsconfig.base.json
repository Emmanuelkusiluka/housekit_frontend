{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@housekit/ui": ["packages/ui/src/index.ts"],
      "@housekit/ui/*": ["packages/ui/src/*"],
      "@housekit/api-client": ["packages/api-client/src/index.ts"],
      "@housekit/auth": ["packages/auth/src/index.ts"],
      "@housekit/i18n": ["packages/i18n/src/index.ts"],
      "@housekit/app-kit": ["packages/app-kit/src/index.ts"]
    }
  }
}
