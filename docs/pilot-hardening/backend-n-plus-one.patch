diff --git a/tests/test_query_counts.py b/tests/test_query_counts.py
new file mode 100644
index 0000000..6b0298e
--- /dev/null
+++ b/tests/test_query_counts.py
@@ -0,0 +1,68 @@
+"""Guard against N+1 regressions on the list endpoints owners hit most.
+
+Each endpoint must cost a constant number of queries no matter how many rows
+it returns — a pilot account with ~100 tenants made the ledger and charges
+pages issue 100–200 queries before these were fixed.
+"""
+
+from datetime import date
+from decimal import Decimal
+
+import pytest
+from django.db import connection
+from django.test.utils import CaptureQueriesContext
+
+from apps.common.tenancy import account_context
+from apps.tenancies.services import register_tenancy
+from tests.factories import CompoundFactory, HouseFactory, ResidentFactory, UnitFactory
+
+pytestmark = pytest.mark.django_db
+
+
+def _seed(account, owner, houses=3, rooms=4):
+    with account_context(account.id):
+        compound = CompoundFactory(account=account)
+        for h in range(houses):
+            house = HouseFactory(account=account, compound=compound)
+            for r in range(rooms):
+                unit = UnitFactory(account=account, house=house, monthly_rent=Decimal("100000"))
+                register_tenancy(
+                    account=account,
+                    unit=unit,
+                    resident=ResidentFactory(account=account),
+                    start_date=date.today().replace(day=1),
+                    contract_months=3,
+                    recorded_by=owner,
+                )
+
+
+def _count(client, path):
+    with CaptureQueriesContext(connection) as ctx:
+        res = client.get(path)
+    assert res.status_code == 200, res.content
+    return len(ctx.captured_queries)
+
+
+@pytest.mark.parametrize(
+    "path",
+    [
+        "/api/v1/ledger/",
+        "/api/v1/charges/?page_size=100",
+        "/api/v1/leases/?page_size=100",
+        "/api/v1/houses/?page_size=100",
+        "/api/v1/compounds/?page_size=100",
+        "/api/v1/residents/?page_size=100",
+        "/api/v1/tenancies/?page_size=100",
+        "/api/v1/units/?page_size=100",
+    ],
+)
+def test_list_query_count_is_constant(account_a, client_auth, path):
+    account, owner = account_a["account"], account_a["owner"]
+    client = client_auth(owner)
+
+    _seed(account, owner, houses=1, rooms=2)
+    small = _count(client, path)
+    _seed(account, owner, houses=3, rooms=5)
+    large = _count(client, path)
+
+    assert large == small, f"{path}: {small} queries for few rows, {large} for many (N+1)"
