index e070786..8012fc8 100644
--- a/apps/payments/models.py
+++ b/apps/payments/models.py
@@ -37,15 +37,40 @@ class RentCharge(TenantScoped):
 
     @property
     def paid_total(self) -> Decimal:
+        # List endpoints annotate this in SQL (see `with_paid_total`) so a page
+        # of N charges costs one query instead of N aggregate queries.
+        annotated = getattr(self, "annotated_paid_total", None)
+        if annotated is not None:
+            return annotated
         # Voided payments never count toward the balance (audit §01b).
         agg = self.payments.filter(is_void=False).aggregate(total=models.Sum("amount"))
         return agg["total"] or Decimal("0")
 
+
     @property
     def balance(self) -> Decimal:
         return self.amount_due - self.paid_total
 
 
+def with_paid_total(qs):
+    """Annotate each charge's non-void paid total in one query.
+
+    Use only on read-only list/report querysets: the value is a snapshot, so a
+    view that records a payment and then reads `paid_total` must use a fresh,
+    un-annotated instance.
+    """
+    from django.db.models import DecimalField, Q, Sum, Value
+    from django.db.models.functions import Coalesce
+
+    return qs.annotate(
+        annotated_paid_total=Coalesce(
+            Sum("payments__amount", filter=Q(payments__is_void=False)),
+            Value(Decimal("0")),
+            output_field=DecimalField(max_digits=12, decimal_places=2),
+        )
+    )
+
+
 class PaymentMethod(models.TextChoices):
     CASH = "cash", "Cash"
     MOBILE_MONEY = "mobile_money", "Mobile money"
